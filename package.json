{
  "name": "kautian-mirror",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone search site for the MOE Dictionary of Frequently-Used Taiwan Taiwanese.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:index": "node vendor/kautian-extension/scripts/build-data.mjs",
    "build:audio": "node scripts/fetch-audio.mjs",
    "build:entries": "node scripts/build-entries.mjs",
    "build:site": "node esbuild.config.mjs",
    "build": "npm run build:index && npm run build:entries && npm run build:site",
    "serve": "node esbuild.config.mjs --serve",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
